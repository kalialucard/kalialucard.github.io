---
// Toc.astro — sticky table of contents (populated client-side from headings)
---

<nav id="toc" aria-label="Table of contents"
  class="hidden xl:block sticky top-20 w-56 shrink-0 self-start max-h-[calc(100vh-6rem)] overflow-y-auto">
  <p class="font-mono text-xs text-muted uppercase tracking-widest mb-3">Contents</p>
  <ul id="toc-list" class="space-y-1 font-mono text-xs" role="list">
    <!-- populated by JS -->
  </ul>
</nav>

<script>
  function buildToc() {
    const article = document.getElementById('post-content');
    if (!article) return;

    const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>('h2, h3'));
    const list = document.getElementById('toc-list');
    if (!list || headings.length === 0) return;

    const items: HTMLLIElement[] = [];

    headings.forEach(h => {
      if (!h.id) {
        h.id = h.textContent!.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      }
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent;
      a.className = [
        'block py-0.5 transition-colors text-muted hover:text-text',
        h.tagName === 'H3' ? 'pl-3 text-[0.7rem]' : '',
        'focus-visible:outline-2 focus-visible:outline-accent rounded',
      ].join(' ');
      li.appendChild(a);
      list.appendChild(li);
      items.push(li);
    });

    // Highlight active heading via IntersectionObserver
    const obs = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            items.forEach(li => li.querySelector('a')?.classList.remove('text-accent'));
            const id = (entry.target as HTMLElement).id;
            const active = items.find(li => li.querySelector('a')?.getAttribute('href') === `#${id}`);
            active?.querySelector('a')?.classList.add('text-accent');
          }
        });
      },
      { rootMargin: '-10% 0px -80% 0px' }
    );

    headings.forEach(h => obs.observe(h));
  }

  document.addEventListener('DOMContentLoaded', buildToc);
</script>
