---
import { profile } from '@/data/profile';
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="font-mono text-xs text-muted">
      © {year} {profile.handle}
    </span>

    <nav aria-label="Footer links">
      <ul class="flex items-center gap-6 font-mono text-xs text-muted" role="list">
        {profile.links.github && (
          <li>
            <a href={profile.links.github} target="_blank" rel="noopener noreferrer"
               class="hover:text-text transition-colors focus-visible:outline-2 focus-visible:outline-accent rounded">
              github
            </a>
          </li>
        )}
        {profile.links.email && (
          <li>
            <a href={`mailto:${profile.links.email}`}
               class="hover:text-text transition-colors focus-visible:outline-2 focus-visible:outline-accent rounded">
              email
            </a>
          </li>
        )}
        <li>
          <a href="/.well-known/security.txt"
             class="hover:text-text transition-colors focus-visible:outline-2 focus-visible:outline-accent rounded">
            security.txt
          </a>
        </li>
        <li>
          <a href="/rss.xml"
             class="hover:text-text transition-colors focus-visible:outline-2 focus-visible:outline-accent rounded">
            rss
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
