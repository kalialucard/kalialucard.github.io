---
// src/pages/credentials/index.astro
// Route: /credentials/  (old /certs/ redirects here)
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import credlyData from '@/data/credly.json';

// Map Credly snapshot by ID for lookup
const credlyMap = Object.fromEntries(credlyData.map((b: any) => [b.id, b]));

function fmt(dateStr: string | null): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

// Badge IDs — ordered per spec
const FEATURED_CISCO = [
  'efc9b5bf-d030-4933-8f0f-1879c67547a1', // Ethical Hacker
  'f986b6e7-26af-4988-9233-b905cd225237', // Junior Cybersecurity Analyst Career Path
  '992ebeca-0bf1-4724-84b8-31027d769049', // Cyber Threat Management
  'f2effa0d-af42-4747-a3e4-b7bd970a6067', // Network Defense
  '0ecec055-2b5e-428b-9bef-e24071717618', // Endpoint Security
];
const FOUNDATIONS_CISCO = [
  '19801ee8-0fd5-4011-8471-e929f7ca210b', // Introduction to Cybersecurity
  '63534d16-2964-449b-adca-dbaa22953082', // Networking Basics
  '7182777f-8d34-42bf-b84e-c5815dc148e1', // Networking Devices and Initial Configuration
  'dbb3fc3b-8b4e-4e48-babd-c902d3d42fd8', // Computer Hardware Basics
];
const ISC2_ID = 'b1157d42-ae48-4c72-be65-bd00ede97bff';
---

<Base
  title="Credentials"
  description="Course badges and certificates, each verifiable at its issuer."
>
  <Nav slot="nav" />
  <Footer slot="footer" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="font-mono text-xs text-muted mb-6">~/credentials</p>
    <h1 class="text-3xl font-semibold text-text mb-3">Credentials & Training</h1>
    <p class="text-muted mb-12 max-w-xl leading-relaxed">
      Course badges and certificates, each verifiable at its issuer.
    </p>

    <!-- Professional Certificate -->
    <section class="mb-12">
      <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-6 flex items-center gap-3">
        Professional Certificate
        <span class="flex-1 h-px bg-border"></span>
      </h2>
      <div class="border border-border rounded-lg p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:border-accent/30 transition-colors max-w-xl">
        <div>
          <p class="text-sm font-medium text-text">Google IT Support Professional Certificate</p>
          <p class="font-mono text-xs text-muted mt-0.5">Google / Coursera</p>
        </div>
        <a href="https://coursera.org/share/b10e2589550e1570dbad49eb220b36e7"
           target="_blank" rel="noopener noreferrer"
           class="font-mono text-xs text-accent hover:underline shrink-0 focus-visible:outline-2 focus-visible:outline-accent rounded">
          Verify on Coursera ↗
        </a>
      </div>
    </section>

    <!-- Cisco Featured -->
    <section class="mb-8">
      <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-2 flex items-center gap-3">
        Cisco Networking Academy: Course Badges (student-level)
        <span class="flex-1 h-px bg-border"></span>
      </h2>
      <p class="font-mono text-xs text-muted mb-6">Featured</p>
      <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4" role="list">
        {FEATURED_CISCO.map(id => {
          const b = credlyMap[id];
          if (!b) return null;
          return (
            <li>
              <a href={b.url} target="_blank" rel="noopener noreferrer"
                 class="group flex flex-col items-center gap-2 p-3 rounded-lg border border-border
                        hover:border-accent/40 hover:bg-surface transition-colors text-center"
                 aria-label={`${b.name} — Verify on Credly`}>
                <img src={b.local_image} alt={`${b.name} badge`}
                     width="90" height="90"
                     class="rounded-lg group-hover:scale-105 transition-transform duration-200"
                     loading="lazy" decoding="async" />
                <div>
                  <p class="text-xs font-medium text-text leading-snug group-hover:text-accent transition-colors">
                    {b.name}
                  </p>
                  {b.issued_at_date && (
                    <p class="font-mono text-[10px] text-muted/60 mt-0.5">{fmt(b.issued_at_date)}</p>
                  )}
                  <p class="font-mono text-[10px] text-accent/70 mt-1">Verify on Credly ↗</p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Cisco Foundations (collapsible) -->
    <section class="mb-12">
      <details class="group">
        <summary class="font-mono text-xs text-muted cursor-pointer hover:text-text transition-colors mb-4 list-none flex items-center gap-2">
          <svg class="w-3 h-3 transition-transform group-open:rotate-90" xmlns="http://www.w3.org/2000/svg"
               viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6"/>
          </svg>
          Foundations ({FOUNDATIONS_CISCO.length} badges)
        </summary>
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-2" role="list">
          {FOUNDATIONS_CISCO.map(id => {
            const b = credlyMap[id];
            if (!b) return null;
            return (
              <li>
                <a href={b.url} target="_blank" rel="noopener noreferrer"
                   class="group flex flex-col items-center gap-2 p-3 rounded-lg border border-border
                          hover:border-accent/40 hover:bg-surface transition-colors text-center"
                   aria-label={`${b.name} — Verify on Credly`}>
                  <img src={b.local_image} alt={`${b.name} badge`}
                       width="80" height="80"
                       class="rounded-lg group-hover:scale-105 transition-transform duration-200"
                       loading="lazy" decoding="async" />
                  <div>
                    <p class="text-xs font-medium text-text leading-snug group-hover:text-accent transition-colors">
                      {b.name}
                    </p>
                    {b.issued_at_date && (
                      <p class="font-mono text-[10px] text-muted/60 mt-0.5">{fmt(b.issued_at_date)}</p>
                    )}
                    <p class="font-mono text-[10px] text-accent/70 mt-1">Verify on Credly ↗</p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    </section>

    <!-- ISC2 -->
    <section class="mb-12">
      <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-6 flex items-center gap-3">
        ISC2: Candidate Membership
        <span class="flex-1 h-px bg-border"></span>
      </h2>
      {(() => {
        const b = credlyMap[ISC2_ID];
        if (!b) return null;
        return (
          <div class="flex flex-col sm:flex-row items-start gap-5 max-w-sm">
            <a href={b.url} target="_blank" rel="noopener noreferrer"
               aria-label={`${b.name} — Verify on Credly`}
               class="group shrink-0">
              <img src={b.local_image} alt={`${b.name} badge`}
                   width="100" height="100"
                   class="rounded-lg group-hover:scale-105 transition-transform duration-200"
                   loading="lazy" decoding="async" />
            </a>
            <div>
              <p class="text-sm font-medium text-text">{b.name}</p>
              <p class="font-mono text-xs text-muted mt-0.5">ISC2</p>
              {b.issued_at_date && b.expires_at_date && (
                <p class="font-mono text-xs text-muted/70 mt-1">
                  {fmt(b.issued_at_date)} – {fmt(b.expires_at_date)}
                </p>
              )}
              <a href={b.url} target="_blank" rel="noopener noreferrer"
                 class="font-mono text-xs text-accent hover:underline mt-2 inline-block focus-visible:outline-2 focus-visible:outline-accent rounded">
                Verify on Credly ↗
              </a>
            </div>
          </div>
        );
      })()}
    </section>
  </div>
</Base>
