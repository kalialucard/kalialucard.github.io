---
// src/pages/index.astro — Home page (full rewrite)
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PlatformLinks from '@/components/PlatformLinks.astro';
import { profile } from '@/data/profile';
import { focusAreas } from '@/data/focus';
import credlyData from '@/data/credly.json';
import { getCollection } from 'astro:content';

// Latest 3 write-ups across all labs sections, sorted by date
const labPosts = (await getCollection('labs'))
  .filter(p => p.data.date)
  .sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime())
  .slice(0, 3);

// Credentials strip counts (from self-hosted credly snapshot)
const ciscoCount = (credlyData as any[]).filter((b: any) => b.issuer === 'Cisco Networking Academy').length;

const BOILERPLATE_RE = /^(Detailed technical walkthrough and security analysis|Technical documentation and research)/i;
function labDesc(post: (typeof labPosts)[number]): string | undefined {
  const d = post.data.description;
  return !d || BOILERPLATE_RE.test(d) ? undefined : d;
}
function labSection(post: (typeof labPosts)[number]): string {
  const s = post.data.section ?? post.data.category ?? 'tryhackme';
  return s.toLowerCase();
}
---

<Base
  title="Home"
  description={profile.tagline}
  hasLabsPosts={labPosts.length > 0}
>
  <Nav slot="nav" />
  <Footer slot="footer" hasLabsPosts={labPosts.length > 0} />

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-20 pb-16">
    <p class="font-mono text-xs text-muted mb-4">~/</p>
    <h1 class="text-4xl sm:text-5xl font-semibold text-text mb-2 leading-tight">
      {profile.nickname}
    </h1>
    <p class="font-mono text-sm text-accent mb-4">a.k.a. {profile.handle}</p>
    <p class="text-xl sm:text-2xl text-muted mb-8 max-w-2xl leading-relaxed">
      {profile.tagline}
    </p>
    <div class="flex flex-wrap gap-4 mb-12">
      <a href="/labs/"
         class="inline-flex items-center gap-2 bg-accent text-bg font-semibold px-5 py-2.5 rounded
                hover:bg-accent/90 transition-colors focus-visible:outline-2 focus-visible:outline-accent">
        Labs
      </a>
      <a href="/contact/"
         class="inline-flex items-center gap-2 border border-border text-text px-5 py-2.5 rounded
                hover:border-accent/50 hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-accent">
        Contact
      </a>
    </div>

    <!-- Platform profiles -->
    <PlatformLinks />
  </section>

  <!-- What I Test -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-8">What I test</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {focusAreas.map(area => (
          <div class="bg-surface border border-border rounded-lg p-5 hover:border-accent/30 transition-colors">
            <div class="text-accent mb-3" set:html={area.icon} />
            <h3 class="font-semibold text-text mb-2 text-sm">{area.title}</h3>
            <p class="text-xs text-muted leading-relaxed">{area.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest write-ups (hidden when empty) -->
  {labPosts.length > 0 && (
    <section class="border-t border-border">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-mono text-xs text-muted uppercase tracking-widest">Latest write-ups</h2>
          <a href="/labs/" class="font-mono text-xs text-accent hover:underline">view all →</a>
        </div>
        <ul class="space-y-4" role="list">
          {labPosts.map(post => {
            const section = labSection(post);
            const desc = labDesc(post);
            return (
              <li class="border border-border rounded-lg p-5 hover:border-accent/30 transition-colors">
                <a href={`/labs/${section}/${post.slug}/`} class="group block focus-visible:outline-2 focus-visible:outline-accent rounded">
                  <div class="flex flex-wrap items-center gap-3 mb-1.5">
                    {post.data.date && (
                      <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-muted">
                        {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
                      </time>
                    )}
                    <span class="font-mono text-xs text-muted/60 uppercase">{section}</span>
                  </div>
                  <h3 class="text-text font-medium group-hover:text-accent transition-colors">{post.data.title}</h3>
                  {desc && <p class="text-sm text-muted mt-1">{desc}</p>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- Credentials & Training strip -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div>
          <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-2">Credentials & Training</h2>
          <p class="text-sm text-muted">
            {ciscoCount} Cisco Networking Academy course badge{ciscoCount !== 1 ? 's' : ''} ·
            {' '}Google IT Support Professional Certificate · ISC2 Candidate
          </p>
        </div>
        <a href="/credentials/"
           class="font-mono text-xs text-accent hover:underline shrink-0 focus-visible:outline-2 focus-visible:outline-accent rounded">
          View credentials →
        </a>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-8">Approach</h2>
      <div class="grid sm:grid-cols-2 gap-8 max-w-2xl">
        <div>
          <p class="font-mono text-xs text-accent mb-2">01 / Reconnaissance</p>
          <p class="text-sm text-muted leading-relaxed">Map attack surface before touching anything. Understand the architecture, data flows, and trust boundaries.</p>
        </div>
        <div>
          <p class="font-mono text-xs text-accent mb-2">02 / Testing</p>
          <p class="text-sm text-muted leading-relaxed">Manual-first with tooling support. Focus on business logic and chained vulnerabilities — the bugs scanners miss.</p>
        </div>
        <div>
          <p class="font-mono text-xs text-accent mb-2">03 / Verification</p>
          <p class="text-sm text-muted leading-relaxed">Reproduce every finding with a minimal proof of concept. Assess real-world impact, not theoretical risk.</p>
        </div>
        <div>
          <p class="font-mono text-xs text-accent mb-2">04 / Reporting</p>
          <p class="text-sm text-muted leading-relaxed">Clear, evidence-based reports with remediation guidance. No padding, no jargon for its own sake.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Policy callout -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <p class="text-sm text-muted">
        I don't publish bug bounty or VDP reports.{' '}
        <a href="/policy/" class="text-accent hover:underline focus-visible:outline-2 focus-visible:outline-accent rounded">
          Read the policy →
        </a>
      </p>
    </div>
  </section>

  <!-- Get in touch -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 text-center">
      <h2 class="text-xl font-semibold text-text mb-3">Get in touch</h2>
      <p class="text-muted mb-6 max-w-md mx-auto">
        Bug bounty collaboration, penetration testing engagement, or responsible disclosure.
      </p>
      <a href="/contact/"
         class="inline-flex items-center gap-2 border border-accent/40 text-accent px-6 py-2.5 rounded
                hover:bg-accent/10 transition-colors focus-visible:outline-2 focus-visible:outline-accent">
        Contact →
      </a>
    </div>
  </section>
</Base>
