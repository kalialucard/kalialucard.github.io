---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PlatformLinks from '@/components/PlatformLinks.astro';
import { profile } from '@/data/profile';

const focusAreas = [
  'Web application security',
  'API security testing',
  'Network and infrastructure penetration testing',
  'Bug bounty and responsible disclosure',
  'Government VDP participation (details confidential)',
];

const certs = profile.certs.filter(c => c.name && !c.name.startsWith('TODO'));
---

<Base title="About" description={`About ${profile.handle} — ${profile.positioning}`}>
  <Nav slot="nav" />
  <Footer slot="footer" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="font-mono text-xs text-muted mb-6">~/about</p>

    <div class="max-w-2xl">
      <h1 class="text-3xl font-semibold text-text mb-2 font-mono">{profile.handle}</h1>
      <p class="font-mono text-sm text-accent mb-6">{profile.positioning}</p>

      <!-- Focus -->
      <section class="mb-10">
        <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Focus</h2>
        <ul class="space-y-2" role="list">
          {focusAreas.map(area => (
            <li class="flex items-start gap-3 text-sm text-text/90">
              <span class="font-mono text-accent mt-0.5 shrink-0">›</span>
              {area}
            </li>
          ))}
        </ul>
      </section>

      <!-- Platforms -->
      <section class="mb-10">
        <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Profiles</h2>
        <PlatformLinks />
      </section>

      <!-- Certifications (only show if name is defined) -->
      {certs.length > 0 && (
        <section id="certs" class="mb-10">
          <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Certifications</h2>
          <ul class="space-y-3" role="list">
            {certs.map(cert => (
              <li class="border border-border rounded p-4 flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm text-text font-medium">{cert.name}</p>
                  {cert.issuer && <p class="font-mono text-xs text-muted mt-0.5">{cert.issuer}</p>}
                </div>
                {cert.url && (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer"
                     class="font-mono text-xs text-accent hover:underline shrink-0 focus-visible:outline-2 focus-visible:outline-accent rounded">
                    verify ↗
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>
