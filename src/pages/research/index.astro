---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import SeverityChip from '@/components/SeverityChip.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', e => e.data.disclosure_ok === true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Research" description="Security research write-ups by kalialucard.">
  <Nav slot="nav" />
  <Footer slot="footer" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="font-mono text-xs text-muted mb-6">~/research</p>
    <h1 class="text-3xl font-semibold text-text mb-3">Research</h1>
    <p class="text-muted mb-10 max-w-xl">
      Public vulnerability write-ups. All findings disclosed with programme permission; private or unpatched issues are never published.
    </p>

    {posts.length === 0 ? (
      <div class="border border-border rounded-lg p-10 text-center">
        <p class="font-mono text-sm text-muted mb-2">// no public write-ups yet</p>
        <p class="text-sm text-muted">Research posts will appear here once disclosure is approved.</p>
      </div>
    ) : (
      <ul class="space-y-5" role="list">
        {posts.map(post => (
          <li class="border border-border rounded-lg p-5 hover:border-accent/30 transition-colors">
            <a href={`/research/${post.slug}/`} class="group block focus-visible:outline-2 focus-visible:outline-accent rounded">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-muted">
                  {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {post.data.severity && <SeverityChip severity={post.data.severity} />}
                {post.data.vuln_class && (
                  <span class="font-mono text-xs text-muted border border-border/60 px-2 py-0.5 rounded">
                    {post.data.vuln_class}
                  </span>
                )}
              </div>
              <h2 class="text-text font-medium group-hover:text-accent transition-colors mb-1">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted">{post.data.description}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {post.data.tags.map((t: string) => (
                    <span class="font-mono text-xs text-muted border border-border/40 px-2 py-0.5 rounded-full">
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
