---
import Post from '@/layouts/Post.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('research', e => e.data.disclosure_ok === true);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await post.render();

// Rough reading time: ~200 words/min
const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = words > 0 ? Math.max(1, Math.ceil(words / 200)) : undefined;
---

<Post
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  severity={post.data.severity}
  vulnClass={post.data.vuln_class}
  targetClass={post.data.target_class}
  status={post.data.status}
  tags={post.data.tags}
  section="research"
  slug={post.slug}
  readingTime={readingTime}
>
  <Content />
</Post>
