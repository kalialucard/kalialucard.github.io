---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
---

<Base title="404 — Not Found">
  <Nav slot="nav" />
  <Footer slot="footer" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20 text-center">
    <p class="font-mono text-6xl font-bold text-accent/30 mb-4">404</p>
    <h1 class="font-mono text-xl text-muted mb-2">not found</h1>
    <p class="font-mono text-sm text-muted mb-8">
      <span class="text-accent">$</span> cd /this/path → <span class="text-red-400">No such file or directory</span>
    </p>
    <a href="/"
       class="inline-flex items-center gap-2 border border-accent/40 text-accent px-5 py-2 rounded
              hover:bg-accent/10 transition-colors focus-visible:outline-2 focus-visible:outline-accent font-mono text-sm">
      ← go home
    </a>
  </div>
</Base>
