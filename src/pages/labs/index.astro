---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('labs'))
  .sort((a, b) => {
    const da = a.data.date ? a.data.date.getTime() : 0;
    const db = b.data.date ? b.data.date.getTime() : 0;
    return db - da;
  });

// Collect all unique tags and platforms
const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].sort();
const allPlatforms = [...new Set(posts.map(p => p.data.platform).filter(Boolean))].sort();
---

<Base title="Labs" description="HackTheBox and TryHackMe write-ups by kalialucard.">
  <Nav slot="nav" />
  <Footer slot="footer" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="font-mono text-xs text-muted mb-6">~/labs</p>
    <h1 class="text-3xl font-semibold text-text mb-3">Labs</h1>
    <p class="text-muted mb-8 max-w-xl">
      HackTheBox and TryHackMe machine write-ups. Practice environment — not real-world disclosures.
    </p>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2 mb-8" id="filters" role="group" aria-label="Filter posts">
      <button data-filter="all" data-type="platform"
        class="filter-btn active font-mono text-xs px-3 py-1.5 rounded border border-accent/50 text-accent bg-accent/10">
        all
      </button>
      {allPlatforms.map(p => (
        <button data-filter={p} data-type="platform"
          class="filter-btn font-mono text-xs px-3 py-1.5 rounded border border-border text-muted hover:border-accent/30 hover:text-text transition-colors">
          {p}
        </button>
      ))}
      {allTags.slice(0, 12).map(t => (
        <button data-filter={t} data-type="tag"
          class="filter-btn font-mono text-xs px-3 py-1.5 rounded border border-border/60 text-muted hover:border-accent/30 hover:text-text transition-colors">
          #{t}
        </button>
      ))}
    </div>

    <!-- Grid -->
    {posts.length === 0 ? (
      <p class="font-mono text-sm text-muted">No write-ups yet.</p>
    ) : (
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" id="labs-grid" role="list">
        {posts.map(post => (
          <li
            data-platform={post.data.platform ?? ''}
            data-tags={JSON.stringify(post.data.tags ?? [])}
            class="lab-card border border-border rounded-lg p-4 hover:border-accent/30 transition-colors"
          >
            <a href={`/labs/${post.slug}/`} class="group block focus-visible:outline-2 focus-visible:outline-accent rounded h-full">
              {post.data.platform && (
                <span class="font-mono text-xs text-muted uppercase tracking-wider">{post.data.platform}</span>
              )}
              <h2 class="text-text font-medium group-hover:text-accent transition-colors mt-1 mb-2 text-sm">
                {post.data.title}
              </h2>
              {post.data.difficulty && (
                <span class="font-mono text-xs text-muted">{post.data.difficulty}</span>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {post.data.tags.slice(0, 4).map((t: string) => (
                    <span class="font-mono text-[0.65rem] text-muted border border-border/40 px-1.5 py-0.5 rounded-full">
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.lab-card');

  let activePlatform = 'all';
  let activeTag = '';

  function applyFilters() {
    cards.forEach(card => {
      const platform = card.dataset.platform ?? '';
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');

      const platformOk = activePlatform === 'all' || platform === activePlatform;
      const tagOk = !activeTag || tags.includes(activeTag);

      card.style.display = platformOk && tagOk ? '' : 'none';
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      const filter = btn.dataset.filter ?? '';

      if (type === 'platform') {
        activePlatform = filter;
        activeTag = '';
      } else {
        activeTag = activeTag === filter ? '' : filter;
      }

      // Update active styling
      buttons.forEach(b => {
        const isActive =
          (b.dataset.type === 'platform' && b.dataset.filter === activePlatform) ||
          (b.dataset.type === 'tag' && b.dataset.filter === activeTag);
        b.classList.toggle('active', isActive);
        b.classList.toggle('border-accent/50', isActive);
        b.classList.toggle('text-accent', isActive);
        b.classList.toggle('bg-accent/10', isActive);
        b.classList.toggle('border-border', !isActive);
        b.classList.toggle('text-muted', !isActive);
      });

      applyFilters();
    });
  });
</script>
