---
// src/pages/labs/index.astro — Labs hub: 3×2 section grid
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';
import { labSections } from '@/data/labSections';

const allPosts = (await getCollection('labs')).filter(p => p.data.date);

// Compute per-section stats
const sectionStats = labSections.map(section => {
  const posts = allPosts
    .filter(p => (p.data.section ?? 'tryhackme') === section.id)
    .sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime());
  const latest = posts[0]?.data.date;
  return { section, count: posts.length, latest };
});

const totalPosts = allPosts.length;
---

<Base
  title="Labs"
  description="Security lab write-ups across TryHackMe, Hack The Box, smart contract training, and more."
  hasLabsPosts={totalPosts > 0}
>
  <Nav slot="nav" />
  <Footer slot="footer" hasLabsPosts={totalPosts > 0} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="font-mono text-xs text-muted mb-6">~/labs</p>
    <h1 class="text-3xl font-semibold text-text mb-3">Labs</h1>
    <p class="text-muted mb-10 max-w-xl">
      Practice write-ups from training platforms and personal exercises. These are not real-world
      targets or vulnerability disclosures.
    </p>

    <!-- 3×2 section grid -->
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
      {sectionStats.map(({ section, count, latest }) => (
        <li>
          <a
            href={`/labs/${section.id}/`}
            class="group flex flex-col h-full border border-border rounded-lg p-5
                   hover:border-accent/30 transition-colors focus-visible:outline-2
                   focus-visible:outline-accent"
          >
            <h2 class="text-text font-semibold group-hover:text-accent transition-colors mb-2">
              {section.title}
            </h2>
            <p class="text-xs text-muted leading-relaxed flex-1 mb-4">
              {section.description}
            </p>
            <div class="flex items-center justify-between font-mono text-xs text-muted">
              {count === 0 ? (
                <span class="text-muted/50 italic">Coming soon</span>
              ) : (
                <span>{count} write-up{count !== 1 ? 's' : ''}</span>
              )}
              {latest && (
                <time datetime={latest.toISOString()}>
                  {latest.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })}
                </time>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
