---
// src/pages/labs/[...slug].astro — Redirect legacy /labs/<slug>/ → /labs/tryhackme/<slug>/
// All existing posts were TryHackMe; new posts use the [section]/[slug] route.
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('labs');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { slug: post.slug, section: post.data.section ?? 'tryhackme' },
  }));
}

const { slug, section } = Astro.props;
// Use 301 redirect via Astro.redirect for SSG: render a redirect page
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Redirecting…</title>
  <meta http-equiv="refresh" content={`0; url=/labs/${section}/${slug}/`} />
  <link rel="canonical" href={`/labs/${section}/${slug}/`} />
</head>
<body>
  <p>Redirecting to <a href={`/labs/${section}/${slug}/`}>/labs/{section}/{slug}/</a></p>
</body>
</html>
