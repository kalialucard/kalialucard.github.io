---
// src/pages/labs/[section]/[slug].astro — Lab post page (new URL structure)
import Post from '@/layouts/Post.astro';
import { getCollection } from 'astro:content';
import { labSections } from '@/data/labSections';

const BOILERPLATE_RE = /^(Detailed technical walkthrough and security analysis|Technical documentation and research)/i;

export async function getStaticPaths() {
  const posts = await getCollection('labs');
  return posts.map(post => {
    const section = post.data.section ?? 'tryhackme';
    return {
      params: { section, slug: post.slug },
      props: { post, sectionId: section },
    };
  });
}

const { post, sectionId } = Astro.props;
const { Content, headings } = await post.render();

const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = words > 0 ? Math.max(1, Math.ceil(words / 200)) : undefined;

// Meta description: suppress boilerplate
const rawDesc = post.data.description;
const metaDesc = rawDesc && !BOILERPLATE_RE.test(rawDesc)
  ? rawDesc
  : `${sectionId.charAt(0).toUpperCase() + sectionId.slice(1)} write-up: ${post.data.title}`;

// Prev / next within the same section
const allPosts = (await getCollection('labs'))
  .filter(p => (p.data.section ?? 'tryhackme') === sectionId && p.data.date)
  .sort((a, b) => a.data.date!.getTime() - b.data.date!.getTime());
const idx = allPosts.findIndex(p => p.slug === post.slug);
const prevPost = idx > 0 ? allPosts[idx - 1] : undefined;
const nextPost = idx < allPosts.length - 1 ? allPosts[idx + 1] : undefined;

const sectionData = labSections.find(s => s.id === sectionId);
---

<Post
  title={post.data.title}
  description={metaDesc}
  date={post.data.date}
  tags={post.data.tags}
  section={`labs/${sectionId}` as any}
  slug={post.slug}
  readingTime={readingTime}
>
  <!-- Practice environment notice -->
  <div class="mb-6 border border-border/60 bg-surface rounded-lg px-4 py-3 text-xs text-muted font-mono">
    Practice environment, not a real-world target.
  </div>

  <Content />

  <!-- Prev / next navigation -->
  {(prevPost || nextPost) && (
    <nav class="mt-12 pt-8 border-t border-border flex flex-col sm:flex-row gap-4 justify-between" aria-label="Post navigation">
      {prevPost ? (
        <a href={`/labs/${sectionId}/${prevPost.slug}/`}
           class="group flex flex-col border border-border rounded-lg p-4 hover:border-accent/30 transition-colors max-w-xs">
          <span class="font-mono text-xs text-muted mb-1">← Previous</span>
          <span class="text-sm text-text group-hover:text-accent transition-colors">{prevPost.data.title}</span>
        </a>
      ) : <div />}
      {nextPost && (
        <a href={`/labs/${sectionId}/${nextPost.slug}/`}
           class="group flex flex-col border border-border rounded-lg p-4 hover:border-accent/30 transition-colors max-w-xs sm:items-end sm:text-right">
          <span class="font-mono text-xs text-muted mb-1">Next →</span>
          <span class="text-sm text-text group-hover:text-accent transition-colors">{nextPost.data.title}</span>
        </a>
      )}
    </nav>
  )}
</Post>
